rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdminUid() {
      return isSignedIn() &&
        request.auth.uid in ['9zVKHJ11zaXD0f4GI6P7LHD6re32'];
    }

    function isAdminEmail() {
      return isSignedIn() &&
        request.auth.token.email != null &&
        request.auth.token.email in [
          'michael.marga@gmail.com',
          'vasquezperlie18@gmail.com'
        ];
    }

    function isAdmin() {
      return isAdminUid() || isAdminEmail();
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function memberData(uid) {
      return get(/databases/$(database)/documents/goMission_members/$(uid)).data;
    }

    function hasExplicitGroupCreationAuthorization(uid) {
      let m = memberData(uid);
      return m != null && (
        m.canCreateGroup == true ||
        m.endorsementApproved == true ||
        m.leaderEndorsed == true ||
        m.endorsedToLead == true ||
        (m.roles != null && (
          m.roles.isAdmin == true ||
          m.roles.canCreateGroup == true ||
          m.roles.isGroupLeader == true
        ))
      );
    }

    function hasNoUplineCreationExemption(uid) {
      let m = memberData(uid);
      let email = request.auth.token.email != null
        ? request.auth.token.email
        : (m != null && m.email is string ? m.email : '');
      return uid in [
          '9zVKHJ11zaXD0f4GI6P7LHD6re32', // Founder
          'QRjyNLzDvwZxqjoIA3hQVnNf7Bs1' // Co-founder (Irene)
        ] ||
        email in [
          'michael.marga@gmail.com',
          'shannen.emerald04@gmail.com'
        ];
    }

    function hasValidUplineForLeadership(uid) {
      let m = memberData(uid);
      let g = m != null && m.uplineGroupId is string && m.uplineGroupId.size() > 0
        ? get(/databases/$(database)/documents/goMission_groups/$(m.uplineGroupId)).data
        : {};
      return m != null &&
        m.uplineGroupId is string &&
        m.uplineGroupId.size() > 0 &&
        g.leaderId is string &&
        g.leaderId != uid;
    }

    function touchesProtectedMemberFields() {
      return (
        request.resource.data.groupId != resource.data.groupId ||
        request.resource.data.uplineGroupId != resource.data.uplineGroupId ||
        request.resource.data.groupRole != resource.data.groupRole ||
        request.resource.data.roles != resource.data.roles ||
        request.resource.data.canCreateGroup != resource.data.canCreateGroup ||
        request.resource.data.endorsementApproved != resource.data.endorsementApproved ||
        request.resource.data.leaderEndorsed != resource.data.leaderEndorsed ||
        request.resource.data.endorsedToLead != resource.data.endorsedToLead
      );
    }

    function hasProtectedMemberPrivileges(data) {
      let roles = data.roles != null ? data.roles : {};
      return (
        data.groupId != null ||
        data.uplineGroupId != null ||
        data.groupRole != null ||
        data.canCreateGroup == true ||
        data.endorsementApproved == true ||
        data.leaderEndorsed == true ||
        data.endorsedToLead == true ||
        roles.isAdmin == true ||
        roles.canCreateGroup == true ||
        roles.isGroupLeader == true
      );
    }

    function canSelfAppendOwnJoinRequest() {
      let changed = request.resource.data.diff(resource.data).changedKeys();
      let existing = resource.data.joinRequests is list ? resource.data.joinRequests : [];
      let incoming = request.resource.data.joinRequests is list ? request.resource.data.joinRequests : [];
      let newIndex = existing.size();
      let newEntry = incoming[newIndex];
      return isSignedIn() &&
        changed.hasOnly(['joinRequests']) &&
        incoming.size() == newIndex + 1 &&
        incoming.hasAll(existing) &&
        newEntry is map &&
        (
          newEntry.odId == request.auth.uid ||
          newEntry.uid == request.auth.uid
        );
    }

    function canSelfAppendOwnPendingRequest() {
      let changed = request.resource.data.diff(resource.data).changedKeys();
      let existing = resource.data.pendingRequests is list ? resource.data.pendingRequests : [];
      let incoming = request.resource.data.pendingRequests is list ? request.resource.data.pendingRequests : [];
      let newIndex = existing.size();
      let newEntry = incoming[newIndex];
      return isSignedIn() &&
        changed.hasOnly(['pendingRequests']) &&
        incoming.size() == newIndex + 1 &&
        incoming.hasAll(existing) &&
        newEntry is map &&
        (
          newEntry.uid == request.auth.uid ||
          newEntry.odId == request.auth.uid
        );
    }

    function isOptionalString(value, maxLength) {
      return value == null || (value is string && value.size() <= maxLength);
    }

    function isValidWatchMessageType(value) {
      return value in ['comment', 'prayer_request', 'chat_with_us'];
    }

    function matchesCallerUserId(userId) {
      return isSignedIn() && userId == request.auth.uid;
    }

    // Watch module (signed-in read, admin write)
    match /video_series/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /video_episodes/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /video_events/{docId} {
      allow create: if
        isSignedIn() &&
        request.resource.data.keys().hasOnly([
          'userId',
          'episodeId',
          'eventType',
          'ts',
          'sessionId'
        ]) &&
        request.resource.data.userId is string &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.episodeId is string &&
        request.resource.data.episodeId.size() > 0 &&
        request.resource.data.episodeId.size() <= 200 &&
        request.resource.data.eventType is string &&
        request.resource.data.eventType in ['onPlay', 'watched_30s', 'watched_90pct', 'onEnd'] &&
        request.resource.data.ts == request.time &&
        request.resource.data.sessionId is string &&
        request.resource.data.sessionId.size() > 0 &&
        request.resource.data.sessionId.size() <= 120;
      allow read, update, delete: if isAdmin();
    }

    match /video_inbox/{docId} {
      allow create: if
        request.resource.data.keys().hasOnly([
          'userId',
          'episodeId',
          'seriesId',
          'messageType',
          'message',
          'contactName',
          'contactEmail',
          'status',
          'source',
          'ts',
          'sessionId',
          'pagePath',
          'userAgent'
        ]) &&
        request.resource.data.userId is string &&
        request.resource.data.userId.size() > 0 &&
        request.resource.data.userId.size() <= 128 &&
        matchesCallerUserId(request.resource.data.userId) &&
        request.resource.data.episodeId is string &&
        request.resource.data.episodeId.size() > 0 &&
        request.resource.data.episodeId.size() <= 200 &&
        isOptionalString(request.resource.data.seriesId, 200) &&
        request.resource.data.messageType is string &&
        isValidWatchMessageType(request.resource.data.messageType) &&
        request.resource.data.message is string &&
        request.resource.data.message.size() >= 2 &&
        request.resource.data.message.size() <= 1200 &&
        isOptionalString(request.resource.data.contactName, 120) &&
        isOptionalString(request.resource.data.contactEmail, 160) &&
        request.resource.data.status == 'new' &&
        request.resource.data.source == 'watch_player' &&
        request.resource.data.ts == request.time &&
        request.resource.data.sessionId is string &&
        request.resource.data.sessionId.size() > 0 &&
        request.resource.data.sessionId.size() <= 120 &&
        isOptionalString(request.resource.data.pagePath, 400) &&
        isOptionalString(request.resource.data.userAgent, 512);
      allow read, update, delete: if isAdmin();
    }

    // Admin publishing collections
    match /goMission_sundayVideos/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /goMission_announcements/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /goMission_trainingContent/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /goMission_config/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Member profiles
    match /goMission_members/{uid} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || (isSelf(uid) && !hasProtectedMemberPrivileges(request.resource.data));
      allow update: if isAdmin() || (isSelf(uid) && !touchesProtectedMemberFields());
      allow delete: if isSelf(uid) || isAdmin();
    }

    // Core app data
    match /goMission_groups/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.leaderId == request.auth.uid && (
          hasNoUplineCreationExemption(request.auth.uid) ||
          hasValidUplineForLeadership(request.auth.uid)
        );
      allow update: if
        isAdmin() ||
        (isSignedIn() && resource.data.leaderId == request.auth.uid) ||
        canSelfAppendOwnJoinRequest() ||
        canSelfAppendOwnPendingRequest();
      allow delete: if isAdmin() || (isSignedIn() && resource.data.leaderId == request.auth.uid);
    }

    match /goMission_adminInbox/{docId} {
      allow read: if isAdmin();
      allow create: if
        isSignedIn() &&
        request.resource.data.type == 'upline_unlock_request' &&
        request.resource.data.status == 'new' &&
        request.resource.data.leaderId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /goMission_groupDeletionRequests/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.status == 'pending' &&
        request.resource.data.leaderId == request.auth.uid &&
        request.resource.data.groupId is string &&
        get(/databases/$(database)/documents/goMission_groups/$(request.resource.data.groupId)).data.leaderId == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    match /goMission_chats/{docId} {
      allow read, write: if isSignedIn();
    }

    match /goMission_dmMessages/{docId} {
      allow read, write: if isSignedIn();
    }

    match /goMission_dmThreads/{docId} {
      allow read, write: if isSignedIn();
    }

    match /goMission_friendRequests/{docId} {
      allow read, write: if isSignedIn();
    }

    match /goMission_friendships/{docId} {
      allow read, write: if isSignedIn();
    }

    match /goMission_devotions/{docId} {
      allow read, write: if isSignedIn();
    }

    match /goMission_debriefs/{docId} {
      allow read, write: if isSignedIn();
    }

    match /goMission_meetings/{docId} {
      allow read, write: if isSignedIn();
    }

    match /goMission_meetingStats/{docId} {
      allow read, write: if isSignedIn();
    }

    match /goMission_groupInviteCodes/{docId} {
      allow read, write: if isSignedIn();
    }

    match /goMission_endorsementCodes/{docId} {
      allow read, write: if isSignedIn();
    }

    match /goMission_trainingProgress/{docId} {
      allow read, write: if isSignedIn();
    }

    match /goMission_trainingResponses/{docId} {
      allow read, write: if isSignedIn();
    }

    match /goMission_recentReadings/{docId} {
      allow read, write: if isSignedIn();
    }

    match /goMission_biblePreferences/{docId} {
      allow read, write: if isSignedIn();
    }

    match /goMission_bibleProgress/{docId} {
      allow read, write: if isSignedIn();
    }

    match /goMission_bibleTranslation/{docId} {
      allow read, write: if isSignedIn();
    }

    match /goMission_community_board/{docId} {
      allow read, write: if isSignedIn();
    }

    match /goMission_passwordResets/{docId} {
      allow read, write: if isAdmin();
    }

    // Deny anything not explicitly allowed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
